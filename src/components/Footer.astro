---
import { s, brandImg } from '../lib/data';
import Logo from './Logo.astro';
import DoodleIcon from './DoodleIcon.astro';
import { regions } from '../lib/regions';
const year = new Date().getFullYear();
const ORDE_URL = 'https://vind.architect.be/kenneth-keyaerts/A912091';

interface Props {
  lang?: 'nl' | 'en';
}
const { lang = 'nl' } = Astro.props;
const en = lang === 'en';
const p = (path: string) => (en ? `/en${path}` : path);
---

<footer class="bg-earth-dark text-stone-300">
  <div class="container-page py-14 grid grid-cols-1 md:grid-cols-4 gap-10">
    <div class="md:col-span-1">
      <div class="mb-4"><Logo tone="light" size="sm" /></div>
      <p class="text-sm text-stone-400 leading-relaxed">
        {en ? 'Your partner for a worry-free dream project in Belgium.' : s('footerBioText', 'Uw partner voor een zorgeloos droomproject in België.')}
      </p>
      <div class="mt-6 space-y-2 text-sm">
        <a href={`mailto:${s('contactMailValue', 'kennethkeyaerts@icloud.com')}`} class="text-stone-300 hover:text-terracotta-soft transition-colors w-fit block">
          {s('contactMailValue', 'kennethkeyaerts@icloud.com')}
        </a>
        <p class="text-stone-300">{en ? '2500 Lier, Antwerp Province, Belgium' : s('contactRegionValue', '2500 Lier, Provincie Antwerpen te België')}</p>
      </div>
    </div>

    <div>
      <h3 class="text-xs font-bold uppercase tracking-wider text-terracotta-soft mb-4">
        {en ? 'Navigation' : s('footerNavHeader', 'Navigatie')}
      </h3>
      <ul class="space-y-2.5 text-sm text-stone-400">
        {[
          ['ontdek', en ? '/en/' : '/', en ? 'Discover' : 'Ontdek'],
          ['aanpak', p('/aanpak'), en ? 'Approach' : s('navApproach', 'Aanpak')],
          ['projecten', p('/portfolio'), en ? 'Projects' : s('navProjects', 'Projecten')],
          ['haalbaarheid', p('/haalbaarheid'), en ? 'Feasibility' : s('navFeasibility', 'Haalbaarheid')],
          ['regularisatie', p('/regularisatie'), en ? 'Regularisation' : s('navRegularisatie', 'Regularisatie')],
          ['kenneth', p('/over-ons'), en ? 'About Kenneth' : s('navAbout', 'Over Kenneth')],
          ['contact', p('/contact'), 'Contact'],
        ].map(([icon, href, label]) => (
          <li>
            <a href={href} class="group flex items-center gap-3 hover:text-white transition-colors">
              <DoodleIcon name={icon as any} class="w-5 h-5 shrink-0 text-terracotta-soft/70 group-hover:text-terracotta-soft transition-colors" />
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-xs font-bold uppercase tracking-wider text-terracotta-soft mb-4">
        {en ? '3D Visualisation' : s('footerTrHeader', '3D Visualisatie')}
      </h3>
      <p class="text-sm text-stone-400 leading-relaxed">
        {en
          ? 'For the finest photorealistic 3D renders, we work closely with our sister company Through Renders.'
          : s('footerTrText', 'Voor de allermooiste fotorealistische 3D-renders werken we nauw samen met ons zusterbedrijf Through Renders.')}
      </p>
      <a
        href="https://www.throughrenders.be"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 mt-3 text-sm font-bold text-terracotta-soft hover:text-white transition-colors"
      >
        {en ? 'Visit throughrenders.be' : s('footerTrBtn', 'Bezoek throughrenders.be')} →
      </a>
      <img src={brandImg('brandThroughRenders', '/images/brand/logo-through-renders-full.jpg')} alt="Through Renders" class="h-12 w-auto rounded-md mt-3" width="40" height="56" />
    </div>

    <div>
      <h3 class="text-xs font-bold uppercase tracking-wider text-terracotta-soft mb-4">
        {en ? 'Legal Status' : s('footerLegalHeader', 'Wettelijk Statuut')}
      </h3>
      <p class="text-sm text-stone-400 leading-relaxed">
        {en
          ? 'Kenneth Keyaerts is bound by the code of conduct of the Order of Architects in Belgium (Registration no. A912091). Registered in accordance with Belgian law.'
          : s('footerLawText1', 'Kenneth Keyaerts is onderworpen aan de deontologische reglementen van de Orde van Architecten in België (Stamnummer A912091). Geregistreerd conform de Belgische wetgeving.')}
      </p>
      <a href={ORDE_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 mt-3 text-sm font-bold text-terracotta-soft hover:text-white transition-colors">
        {en ? 'Order of Architects website' : s('footerLegalBtn', 'Orde van Architecten website')} →
      </a>
    </div>
  </div>

  <div class="border-t border-white/10">
    <nav aria-label={en ? 'Working area' : 'Werkgebied'} class="container-page py-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
      <span class="text-[11px] font-bold uppercase tracking-wider text-stone-500">{en ? 'Working area' : 'Werkgebied'}</span>
      {regions.slice(0, 4).map((r) => (
        <a href={`${p('/architect-' + r.slug)}`} class="text-stone-400 hover:text-white transition-colors">
          {en ? `Architect ${r.en.label}` : `Architect ${r.nl.label}`}
        </a>
      ))}
      <a href={p('/werkgebied')} class="font-bold text-terracotta-soft hover:text-white transition-colors">{en ? 'All areas →' : 'Alle gemeenten →'}</a>
    </nav>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page py-6 flex flex-wrap items-center gap-3">
      <span class="text-[11px] font-bold uppercase tracking-wider text-stone-500 mr-1">{en ? 'Follow & verify' : 'Volg & verifieer'}</span>
      <a
        href={ORDE_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={en ? 'Kenneth Keyaerts on the Order of Architects website (opens in a new tab)' : 'Kenneth Keyaerts op de website van de Orde van Architecten (opent in nieuw tabblad)'}
        class="w-10 h-10 rounded-full border-2 border-white/20 hover:border-terracotta flex items-center justify-center text-stone-300 hover:text-terracotta transition-colors"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5l8-3z"/><path d="M9 12l2 2 4-4"/></svg>
      </a>
      {s('socialInstagramUrl', 'https://www.instagram.com/keydesign.architects/') && (
        <a
          href={s('socialInstagramUrl', 'https://www.instagram.com/keydesign.architects/')}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={en ? 'Key-Design Architects on Instagram (opens in a new tab)' : 'Key-Design Architects op Instagram (opent in nieuw tabblad)'}
          class="w-10 h-10 rounded-full border-2 border-white/20 hover:border-terracotta flex items-center justify-center text-stone-300 hover:text-terracotta transition-colors"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
      )}
      {s('socialLinkedinUrl') && (
        <a
          href={s('socialLinkedinUrl')}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={en ? 'Key-Design Architects on LinkedIn (opens in a new tab)' : 'Key-Design Architects op LinkedIn (opent in nieuw tabblad)'}
          class="w-10 h-10 rounded-full border-2 border-white/20 hover:border-terracotta flex items-center justify-center text-stone-300 hover:text-terracotta transition-colors"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
      )}
      {s('socialGoudenGidsUrl') && (
        <a
          href={s('socialGoudenGidsUrl')}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={en ? 'Key-Design Architects on De Gouden Gids (opens in a new tab)' : 'Key-Design Architects op De Gouden Gids (opent in nieuw tabblad)'}
          class="w-10 h-10 rounded-full border-2 border-white/20 hover:border-terracotta flex items-center justify-center text-stone-300 hover:text-terracotta transition-colors"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 4h11l5 5v11H4z"/><path d="M15 4v5h5"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/></svg>
        </a>
      )}
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page py-5 flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px] text-stone-500">
      <p>© {year} {en ? 'Key-Design Architects. All rights reserved.' : s('footerCopyright', 'Key-Design Architects. Alle rechten voorbehouden.')}</p>
      <a href="#" id="footer-cookie-link" class="hover:text-stone-300 transition-colors underline underline-offset-2">
        {en ? 'Privacy & Cookie Policy (GDPR)' : 'Privacy & Cookie Beleid (AVG)'}
      </a>
    </div>
  </div>
</footer>
