---
import Layout from '../layouts/Layout.astro';
import FloatingDoodles from './FloatingDoodles.astro';
import ArchitecturalMotifs from './ArchitecturalMotifs.astro';
import DoodleIcon from './DoodleIcon.astro';
import { kennis, THEMES, KENNIS_UPDATED, KENNIS_UPDATED_LABEL, type KennisPage } from '../data/kennis';
import { kennisEn, THEMES_EN } from '../data/kennis-en';

interface Props { page: KennisPage }
const { page } = Astro.props;
const siteUrl = 'https://www.keydesignarchitects.be';
const en = page.path.startsWith('/en/');
const TH = en ? THEMES_EN : THEMES;
const theme = TH[page.theme];
const isRegul = !en && page.path.startsWith('/regularisatie');
const pool: (KennisPage & { altPath?: string })[] = en ? kennisEn : kennis;
const extra: Record<string, { path: string; theme: KennisPage['theme']; title: string }> = {
  '/en/regularisatie': { path: '/en/regularisatie', theme: 'regularisatie', title: 'Regularisation of unpermitted work' },
};
const related = page.related.map((p) => pool.find((k) => k.path === p) || (extra[p] as any)).filter(Boolean) as KennisPage[];
// Pages without a direct counterpart send the EN/NL toggle to the other language's knowledge hub.
const altLangPath = en
  ? ((page as any).altPath || '/kennis')
  : (kennisEn.find((k) => k.altPath === page.path)?.path || '/en/knowledge');
const T = en
  ? { crumbHome: 'Knowledge', crumbHub: '/en/knowledge', answer: 'Short answer', faq: 'Frequently asked questions', also: 'Read also', nav: 'Breadcrumb', ctaH: { haalbaarheid: 'Want to know what is possible on your plot or in your home?', contact: 'Not sure about your situation?' }, ctaP: { haalbaarheid: 'Try our feasibility tool for a first indication, or ask for a first conversation.', contact: 'A first assessment costs nothing and helps you move forward.' }, ctaBtn: { haalbaarheid: 'Go to the feasibility tool', contact: 'Discuss your situation with Kenneth' }, area: 'We work in', areaTail: 'See our work area', disclaimer: 'General information, not legal advice. Last updated:', updated: 'October 2026', contactPath: '/en/contact', haalPath: '/en/haalbaarheid', base: '/en', regions: ['Antwerp', 'the Kempen', 'Mechelen', 'Lier'] }
  : { crumbHome: 'Kennis', crumbHub: '/kennis', answer: 'Kort antwoord', faq: 'Veelgestelde vragen', also: 'Lees ook', nav: 'Kruimelpad', ctaH: { haalbaarheid: 'Wil u weten wat er mogelijk is op uw perceel of in uw woning?', contact: 'Twijfelt u over uw situatie?' }, ctaP: { haalbaarheid: 'Probeer onze haalbaarheidstool voor een eerste indicatie, of vraag een eerste gesprek aan.', contact: 'Een eerste inschatting kost u niets en helpt u meteen verder.' }, ctaBtn: { haalbaarheid: 'Naar de haalbaarheidstool', contact: 'Bespreek uw situatie met Kenneth' }, area: 'Wij werken in', areaTail: 'Bekijk ons werkgebied', disclaimer: 'Algemene informatie, geen juridisch advies. Bijgewerkt:', updated: KENNIS_UPDATED_LABEL, contactPath: '/contact', haalPath: '/haalbaarheid', base: '', regions: ['Antwerpen', 'de Kempen', 'Mechelen', 'Lier'] };
const icon = page.theme === 'regularisatie' ? 'regularisatie' : page.theme === 'kosten' ? 'haalbaarheid' : page.theme === 'bouwen' ? 'projecten' : 'aanpak';

const crumbs = isRegul
  ? [{ name: 'Regularisatie', url: '/regularisatie' }, { name: page.title, url: page.path }]
  : [{ name: T.crumbHome, url: T.crumbHub }, { name: page.title, url: page.path }];

const jsonLd: Record<string, unknown>[] = [
  {
    '@type': 'Article',
    headline: page.title,
    description: page.description,
    mainEntityOfPage: `${siteUrl}${page.path}`,
    inLanguage: en ? 'en' : 'nl-BE',
    dateModified: KENNIS_UPDATED,
    datePublished: KENNIS_UPDATED,
    author: { '@type': 'Person', name: 'Kenneth Keyaerts', jobTitle: 'Architect' },
    publisher: { '@id': `${siteUrl}/#firm` },
  },
];
if (page.faq.length) {
  jsonLd.push({
    '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---

<Layout title={page.metaTitle} description={page.description} path={page.path} breadcrumbs={crumbs} jsonLd={jsonLd} lang={en ? 'en' : 'nl'} altLangPath={altLangPath}>
  <!-- INTRO + DIRECT ANSWER -->
  <section class="relative overflow-hidden py-12 sm:py-16 bg-sand-light isolate">
    <FloatingDoodles seed={1} />
    <ArchitecturalMotifs variant="c" />
    <div class="container-page max-w-2xl">
      <nav aria-label={T.nav} class="reveal text-xs text-earth-muted mb-5">
        <a href={isRegul ? '/regularisatie' : T.crumbHub} class="hover:text-terracotta transition-colors">← {isRegul ? 'Regularisatie' : T.crumbHome}</a>
      </nav>
      <DoodleIcon name={icon as any} animate class="reveal w-12 h-12 sm:w-14 sm:h-14 text-terracotta mb-3" />
      <span class="reveal text-xs font-bold uppercase tracking-wider text-terracotta">{theme.label}</span>
      <h1 class="reveal text-3xl sm:text-5xl font-bold text-earth-dark mt-2 leading-[1.12]">{page.title}</h1>
      <div class="reveal card-cartoon mt-7 p-5 sm:p-6" style="transition-delay:.1s;">
        <p class="text-[11px] font-bold uppercase tracking-wider text-terracotta mb-2">{T.answer}</p>
        <p class="text-earth-dark leading-relaxed">{page.answer}</p>
      </div>
    </div>
  </section>

  <!-- BODY -->
  <section class="py-12 sm:py-14 bg-white relative overflow-hidden isolate">
    <div class="container-page max-w-2xl space-y-10">
      {page.sections.map((sec) => (
        <div class="reveal">
          <h2 class="text-2xl font-bold text-earth-dark mb-4">{sec.h2}</h2>
          {sec.p?.map((t) => <p class="text-earth-muted leading-relaxed mb-3">{t}</p>)}
          {sec.list && (
            <ul class="space-y-2.5 text-earth-muted">
              {sec.list.map((li) => (
                <li class="flex items-start gap-2.5"><span class="text-terracotta font-bold mt-0.5" aria-hidden="true">•</span><span>{li}</span></li>
              ))}
            </ul>
          )}
          {sec.steps && (
            <ol class="space-y-4">
              {sec.steps.map((st, i) => (
                <li class="flex gap-4">
                  <span class="badge-cartoon w-9 h-9 shrink-0 flex items-center justify-center font-bold text-earth-dark text-sm">{String(i + 1).padStart(2, '0')}</span>
                  <span class="text-earth-muted leading-relaxed pt-1">{st}</span>
                </li>
              ))}
            </ol>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  {page.faq.length > 0 && (
    <section class="py-12 bg-sand-medium relative overflow-hidden isolate">
      <FloatingDoodles seed={2} />
      <div class="container-page max-w-2xl">
        <h2 class="reveal text-2xl font-bold text-earth-dark mb-5">{T.faq}</h2>
        <div class="space-y-3">
          {page.faq.map((f) => (
            <details class="reveal card-cartoon group p-4 sm:p-5">
              <summary class="cursor-pointer list-none flex items-start justify-between gap-4 font-bold text-earth-dark">
                <span>{f.q}</span>
                <span class="text-terracotta text-xl leading-none transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 text-earth-muted leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- RELATED -->
  {related.length > 0 && (
    <section class="py-12 bg-white relative overflow-hidden isolate">
      <div class="container-page max-w-2xl">
        <h2 class="reveal text-xl font-bold text-earth-dark mb-4">{T.also}</h2>
        <ul class="grid gap-3 sm:grid-cols-2">
          {related.map((r) => (
            <li class="reveal">
              <a href={r.path} class="card-cartoon block p-4 h-full hover:text-terracotta transition-colors">
                <span class="text-[11px] font-bold uppercase tracking-wider text-terracotta block mb-1">{TH[r.theme].label}</span>
                <span class="font-bold text-earth-dark">{r.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-16 bg-earth-dark text-white relative overflow-hidden isolate">
    <FloatingDoodles seed={4} />
    <div class="container-page reveal text-center">
      <h2 class="text-2xl sm:text-3xl font-bold max-w-xl mx-auto">{T.ctaH[page.cta]}</h2>
      <p class="mt-3 text-stone-300 max-w-lg mx-auto">{T.ctaP[page.cta]}</p>
      <a href={page.cta === 'haalbaarheid' ? T.haalPath : `${T.contactPath}?type=${encodeURIComponent(page.ctaType)}`} class="btn-cartoon-primary inline-block mt-7 py-3.5 px-8 text-sm font-bold uppercase tracking-wider">
        {T.ctaBtn[page.cta]} →
      </a>
      <p class="mt-8 text-xs text-stone-400 max-w-xl mx-auto leading-relaxed">
        {T.area} <a href={`${T.base}/architect-antwerpen`} class="underline hover:text-white">{T.regions[0]}</a>, <a href={`${T.base}/architect-kempen`} class="underline hover:text-white">{T.regions[1]}</a>, <a href={`${T.base}/architect-mechelen`} class="underline hover:text-white">{T.regions[2]}</a> {en ? 'and' : 'en'} <a href={`${T.base}/architect-lier`} class="underline hover:text-white">{T.regions[3]}</a>. <a href={`${T.base}/werkgebied`} class="underline hover:text-white">{T.areaTail}</a>.
      </p>
      <p class="mt-4 text-[11px] text-stone-500 max-w-xl mx-auto">{T.disclaimer} {T.updated}.</p>
    </div>
  </section>
</Layout>
