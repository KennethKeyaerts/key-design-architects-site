---
// One logo lockup, used identically in the header, menu and footer so the
// brand never looks different from page to page. The KD mark is an inline
// vector (traced from the original 4000px artwork), so it is razor sharp on
// every screen and takes whatever colour its parent sets via currentColor:
// white on dark/photo backgrounds, dark brown on light ones. The wordmark is
// real text rather than a picture, which also keeps it crisp.
interface Props {
  tone?: 'light' | 'dark'; // light = white lockup for dark/photo backgrounds
  size?: 'sm' | 'md';
  class?: string;
}
const { tone = 'dark', size = 'md', class: className = '' } = Astro.props;
---

<span
  class={`kd-logo kd-logo--${size} ${tone === 'light' ? 'kd-logo--light' : 'kd-logo--dark'} ${className}`}
  role="img"
  aria-label="Key-Design Architects"
>
