<style>
  .kd-logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--logo-h) * 0.3);
    line-height: 1;
  }
  .kd-logo--md { --logo-h: 2.75rem; }
  .kd-logo--sm { --logo-h: 2.5rem; }
  @media (min-width: 640px) {
    .kd-logo--md { --logo-h: 3.5rem; }
  }
  .kd-logo__mark {
    height: var(--logo-h);
    width: auto;
    aspect-ratio: 1400 / 982;
    flex-shrink: 0;
  }
  .kd-logo__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: calc(var(--logo-h) * 0.06);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: calc(var(--logo-h) * 0.3);
    line-height: 1;
  }
  .kd-logo--light { color: #fff; }
  .kd-logo--dark { color: #4E342E; }
  /* a soft shadow (not the old hard offset one) keeps the white lockup
     legible over any photo without making it look heavy */
  .kd-logo--light { filter: drop-shadow(0 1px 10px rgba(0, 0, 0, 0.28)); }
</style>
