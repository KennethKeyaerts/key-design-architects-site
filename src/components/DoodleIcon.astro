---
// One shared icon set, reused everywhere a topic needs a matching visual:
// the slide-in menu, and now a larger, prominent version on each page's own
// intro section, so the whole site shares one recognizable, hand-feel
// visual language instead of icons only living in the menu.
interface Props {
  name: keyof typeof ICONS;
  class?: string;
  animate?: boolean; // draws itself in on scroll, like LineDrawSignature
}

const ICONS = {
  ontdek: '<path d="M6 17 L16 8 L26 17" /><path d="M9 15 V25 H23 V15" /><path d="M14 25 V19 H18 V25" />',
  aanpak: '<circle cx="16" cy="16" r="10" /><path d="M16 9 L19 16 L16 23 L13 16 Z" />',
  projecten: '<rect x="9" y="4" width="17" height="17" rx="1" /><path d="M6 8 V26 H22" /><path d="M9 17 L14 12 L18 16 L21 13 L26 18" /><circle cx="21" cy="8" r="1.6" />',
  haalbaarheid: '<rect x="8" y="4" width="16" height="24" rx="1.5" /><path d="M11 8 H21 V12 H11 Z" /><path d="M12 17 H12.1 M16 17 H16.1 M20 17 H20.1 M12 21 H12.1 M16 21 H16.1 M20 21 H20.1 M12 25 H12.1 M16 25 H20" />',
  regularisatie: '<path d="M10 6 H20 L24 10 V26 H10 Z" /><path d="M20 6 V10 H24" /><path d="M13 16 L15.5 18.5 L21 13" />',
  kenneth: '<circle cx="16" cy="12" r="5" /><path d="M6 27 C6 20 11 17 16 17 C21 17 26 20 26 27" />',
  contact: '<path d="M6 10 H26 V22 H6 Z" /><path d="M6 10 L16 18 L26 10" />',
  kennis: '<path d="M16 8 C13 6 8 6 5 7 V24 C8 23 13 23 16 25 C19 23 24 23 27 24 V7 C24 6 19 6 16 8 Z" /><path d="M16 8 V25" />',
  onderzoek: '<circle cx="14" cy="14" r="8" /><path d="M20 20 L27 27" /><path d="M10 14 H18 M14 10 V18" />',
  pin: '<path d="M16 28 C10 21 7 17 7 13 A9 9 0 0 1 25 13 C25 17 22 21 16 28 Z" /><circle cx="16" cy="13" r="3.2" />',
  pencil: '<path d="M6 26 L8 19 L22 5 L27 10 L13 24 Z" /><path d="M19 8 L24 13" /><path d="M6 26 L11 24" />',
  ruler: '<path d="M4 20 L20 4 L28 12 L12 28 Z" /><path d="M9 15 L12 18 M13 11 L16 14 M17 7 L20 10" />',
  sparkle: '<path d="M16 4 C16 11 21 16 28 16 C21 16 16 21 16 28 C16 21 11 16 4 16 C11 16 16 11 16 4 Z" />',
  tree: '<circle cx="16" cy="12" r="8" /><path d="M16 20 V28 M16 24 L20 21" />',
  key: '<circle cx="10" cy="16" r="5" /><path d="M15 16 H28 M24 16 V20 M20 16 V19" />',
  window: '<rect x="6" y="5" width="20" height="22" /><path d="M16 5 V27 M6 16 H26" />',
  crane: '<path d="M8 28 V6 H26 M8 10 L20 6 M20 6 V14 M20 14 H23 V17 H17 V14 Z M6 28 H12" />',
  arrow: '<path d="M5 22 C10 10 18 8 26 12 M26 12 L20 8 M26 12 L21 17" />',
  stairs: '<path d="M5 27 H11 V21 H17 V15 H23 V9 H28" /><path d="M5 27 V21 M11 21 V15 M17 15 V9" />',
  sun: '<circle cx="16" cy="16" r="5" /><path d="M16 3 V7 M16 25 V29 M3 16 H7 M25 16 H29 M7 7 L10 10 M22 22 L25 25 M25 7 L22 10 M10 22 L7 25" />',
} as const;

const { name, class: className = '', animate = false } = Astro.props;
---

<svg
  class={`${animate ? 'line-draw' : ''} ${className}`}
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={ICONS[name].replace(/<(path|circle|rect)\s/g, '<$1 pathLength="1" ')}
/>
