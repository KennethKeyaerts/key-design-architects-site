---
import FloatingDoodles from '../../components/FloatingDoodles.astro';
import Img from '../../components/Img.astro';
import Layout from '../../layouts/Layout.astro';
import ArchitecturalMotifs from '../../components/ArchitecturalMotifs.astro';
import DoodleIcon from '../../components/DoodleIcon.astro';
import { projects, phaseLabel, getFilterConfig, categoryLabel } from '../../lib/data';

const filterCfg = getFilterConfig();
const categories = filterCfg.items;
const EN = true;
const t = (p: any, key: string) => p.en?.[key] ?? p[key];
---

<Layout
  title="Projects & Realisations | Key-Design Architects"
  description="Discover the realised and ongoing architecture projects of Key-Design Architects: new-build villas, full renovations and interior projects in Lier, Antwerp and the Kempen region."
  path="/en/portfolio"
  lang="en"
  altLangPath="/portfolio"
  breadcrumbs={[{ name: 'Projects', url: '/en/portfolio' }]}
>
  <section class="relative overflow-hidden py-12 sm:py-14 bg-sand-light isolate">
    <FloatingDoodles seed={1} />
    <ArchitecturalMotifs variant="a" />
    <div class="container-page">
      <div class="reveal max-w-2xl mb-8">
        <DoodleIcon name="projecten" animate class="w-14 h-14 sm:w-16 sm:h-16 text-terracotta mb-3" />
        <span class="text-xs font-bold uppercase tracking-wider text-terracotta">Realisations & Concepts</span>
        <h1 class="text-4xl font-bold text-earth-dark mt-2">Selected Projects</h1>
        <p class="mt-4 text-earth-muted leading-relaxed">An overview of realised and ongoing designs, where aesthetics, technique, and budget go hand in hand.</p>
      </div>

      {categories.length > 0 && (
      <div class="reveal flex flex-wrap gap-3 mb-8 pb-1" id="portfolio-filters" role="group" aria-label={filterCfg.all.en}>
        <button type="button" data-filter="alle" class="filter-btn active py-2 px-4 text-xs font-bold uppercase tracking-wider">
          {filterCfg.all.en}
        </button>
        {categories.map((cat) => (
          <button type="button" data-filter={cat.key} class="filter-btn py-2 px-4 text-xs font-bold uppercase tracking-wider">
            {EN ? cat.en : cat.nl}
          </button>
        ))}
      </div>
      )}

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="portfolio-grid">
        {projects.map((p) => (
          <a href={`/en/portfolio/${p.slug}`} data-category={p.category} class="portfolio-card card-cartoon portfolio-grid-item reveal block overflow-hidden">
            <div class={`aspect-[4/3] overflow-hidden bg-sand-medium border-b-2 border-earth-dark pc-media`}>
              <Img src={p.image} alt={p.title} class="w-full h-full object-cover" width="600" height="450" sizes="(min-width:1024px) 50vw, 100vw" />
              <span class="pc-chip" aria-hidden="true">View project →</span>
            </div>
            <div class="p-5">
              <span class="text-[10px] font-bold uppercase tracking-wider text-terracotta">{categoryLabel(p.category, EN)}</span>
              <h2 class="pc-title font-bold text-lg text-earth-dark mt-1">{p.title}</h2><span class="pc-bar" aria-hidden="true"></span>
              <p class="text-xs text-earth-muted mt-1">{t(p, 'location')} · {p.year} · {t(p, 'area')}</p>
              <p class="text-sm text-earth-muted mt-3 line-clamp-2">{t(p, 'description')}</p>
              {(p.phase || p.role === 'collaborated') && (
                <div class="flex flex-wrap gap-1.5 mt-3">
                  {p.phase && <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-sand-medium text-earth-dark">{phaseLabel(p.phase, true)}</span>}
                  {p.role === 'collaborated' && <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-amber-100 text-amber-800">Contributed</span>}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>

      <p class="hidden text-earth-muted mt-6" id="portfolio-empty-state">No projects in this category at the moment.</p>
    </div>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.portfolio-card');
  const emptyState = document.getElementById('portfolio-empty-state');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.dataset.filter;
      let visibleCount = 0;
      cards.forEach((card) => {
        const match = filter === 'alle' || card.dataset.category === filter;
        card.style.display = match ? '' : 'none';
        if (match) visibleCount++;
      });
      emptyState?.classList.toggle('hidden', visibleCount > 0);
    });
  });
</script>
