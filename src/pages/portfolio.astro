---
import FloatingDoodles from '../components/FloatingDoodles.astro';
import Img from '../components/Img.astro';
import Layout from '../layouts/Layout.astro';
import ArchitecturalMotifs from '../components/ArchitecturalMotifs.astro';
import DoodleIcon from '../components/DoodleIcon.astro';
import { s, projects, phaseLabel } from '../lib/data';

const CATEGORY_LABELS: Record<string, string> = {
  nieuwbouw: 'Nieuwbouw',
  renovatie: 'Totaalrenovatie',
  interieur: 'Interieur & Maatwerk',
};

// Always show the full filter system (not just categories currently in use):
// with only a handful of projects today, this is exactly where visitors will
// expect a working index/filter once the portfolio grows to dozens of them.
const categories = Object.keys(CATEGORY_LABELS);
---

<Layout
  title="Projecten & Realisaties | Key-Design Architects"
  description="Ontdek de gerealiseerde en lopende architectuurprojecten van Key-Design Architects: nieuwbouw villa's, totaalrenovaties en interieurprojecten in Lier, Antwerpen en de Kempen."
  path="/portfolio"
  altLangPath="/en/portfolio"
  breadcrumbs={[{ name: 'Projecten', url: '/portfolio' }]}
>
  <section class="relative overflow-hidden py-12 sm:py-14 bg-sand-light isolate">
    <FloatingDoodles seed={1} />
    <ArchitecturalMotifs variant="a" />
    <div class="container-page">
      <div class="reveal max-w-2xl mb-8">
        <DoodleIcon name="projecten" animate class="w-14 h-14 sm:w-16 sm:h-16 text-terracotta mb-3" />
        <span class="text-xs font-bold uppercase tracking-wider text-terracotta">{s('portfolioCategory', 'Realisaties & Concepten')}</span>
        <h1 class="text-4xl font-bold text-earth-dark mt-2">{s('portfolioTitle', 'Geselecteerde Projecten')}</h1>
        <p class="mt-4 text-earth-muted leading-relaxed">{s('portfolioSubtitle')}</p>
      </div>

      {projects.length === 0 && (
        <p class="text-earth-muted">Binnenkort verschijnen hier de eerste projecten.</p>
      )}

      <div class="reveal flex flex-wrap gap-2.5 mb-8" id="portfolio-filters">
        <button
          data-filter="alle"
          class="portfolio-filter-btn active py-2 px-4 rounded-full border-2 border-earth-dark text-xs font-bold uppercase tracking-wider transition-colors"
        >
          Alle projecten
        </button>
        {categories.map((cat) => (
          <button
            data-filter={cat}
            class="portfolio-filter-btn py-2 px-4 rounded-full border-2 border-earth-dark text-xs font-bold uppercase tracking-wider transition-colors"
          >
            {CATEGORY_LABELS[cat] || cat}
          </button>
        ))}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="portfolio-grid">
        {projects.map((p) => (
          <a href={`/portfolio/${p.slug}`} data-category={p.category} class="portfolio-card card-cartoon portfolio-grid-item reveal block overflow-hidden">
            <div class="aspect-[4/3] overflow-hidden bg-sand-medium border-b-2 border-earth-dark">
              <Img src={p.image} alt={p.title} class="w-full h-full object-cover" width="600" height="450" sizes="(min-width:1024px) 50vw, 100vw" />
            </div>
            <div class="p-5">
              <span class="text-[10px] font-bold uppercase tracking-wider text-terracotta">{CATEGORY_LABELS[p.category] || p.category}</span>
              <h2 class="font-bold text-lg text-earth-dark mt-1">{p.title}</h2>
              <p class="text-xs text-earth-muted mt-1">{p.location} · {p.year} · {p.area}</p>
              <p class="text-sm text-earth-muted mt-3 line-clamp-2">{p.description}</p>
              {(p.phase || p.role === 'collaborated') && (
                <div class="flex flex-wrap gap-1.5 mt-3">
                  {p.phase && <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-sand-medium text-earth-dark">{phaseLabel(p.phase, false)}</span>}
                  {p.role === 'collaborated' && <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-amber-100 text-amber-800">Meegewerkt</span>}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>

      <p class="hidden text-earth-muted mt-6" id="portfolio-empty-state">Geen projecten in deze categorie op dit moment.</p>
    </div>
  </section>
</Layout>

<style>
  .portfolio-filter-btn {
    background: white;
    color: #4E342E;
  }
  .portfolio-filter-btn.active {
    background: #C86A4B;
    color: white;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.portfolio-filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.portfolio-card');
  const emptyState = document.getElementById('portfolio-empty-state');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.dataset.filter;
      let visibleCount = 0;
      cards.forEach((card) => {
        const match = filter === 'alle' || card.dataset.category === filter;
        card.style.display = match ? '' : 'none';
        if (match) visibleCount++;
      });
      emptyState?.classList.toggle('hidden', visibleCount > 0);
    });
  });
</script>

