---
import FloatingDoodles from '../components/FloatingDoodles.astro';
import Img from '../components/Img.astro';
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import ArchitecturalMotifs from '../components/ArchitecturalMotifs.astro';
import DoodleIcon from '../components/DoodleIcon.astro';
import { s, siteSettings, projects, getProjectBySlug, brandImg } from '../lib/data';

// Homepage showcase: projects starred in /beheerder first, then the classic pair, then whatever exists.
const featured = [
  ...projects.filter((p) => p.starred),
  getProjectBySlug('woning-lookstraat'),
  getProjectBySlug('kwartier-xiv'),
  ...projects,
].filter((p, i, a): p is NonNullable<typeof p> => Boolean(p) && a.indexOf(p) === i);
const residentialProject = featured[0];
const developmentProject = featured[1];
const introSource = developmentProject ?? residentialProject;
const introImage = introSource?.images?.[3] ?? introSource?.images?.[0] ?? introSource?.image ?? '/images/brand/hero-foto.jpg';
const portrait = brandImg('brandPortrait', '/images/brand/kenneth-portrait.jpg');
const trLogo = brandImg('brandThroughRenders', '/images/brand/logo-through-renders-full.jpg');
---

<Layout
  title="Key-Design Architects | Kenneth Keyaerts - Erkend Architect Lier & Antwerpen"
  description="Exclusieve residentiële architectuur, totaalrenovaties, nieuwbouw villa's, interieur en 3D visualisaties door erkend architect Kenneth Keyaerts. Actief in Lier, Antwerpen en Kempen."
  path="/"
  hasHero
  altLangPath="/en/"
>
  <HeroSection />


  <!-- HET BUREAU: one firm introduction, photography-led, no boxes -->
  <section id="visie" class="relative overflow-hidden py-20 sm:py-28 bg-white isolate">
    <FloatingDoodles seed={1} />
    <ArchitecturalMotifs variant="a" />
    <div class="container-page">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
        <div class="reveal lg:col-span-7">
          <div class="flex items-center gap-3">
            <DoodleIcon name="aanpak" animate class="w-9 h-9 text-terracotta shrink-0" />
            <span class="text-xs font-bold uppercase tracking-wider text-terracotta">{s('introLabel', 'Het bureau')}</span>
          </div>
          <h2 class="mt-6 text-3xl sm:text-5xl font-bold leading-[1.18] text-earth-dark max-w-2xl">{s('introTitle', 'We beginnen niet bij de bezwaren. We beginnen bij het onderzoek.')}</h2>
        </div>
        <div class="reveal lg:col-span-5 space-y-5 text-earth-muted leading-relaxed lg:pt-14" style="transition-delay:0.1s;">
          <p>{s('introText1', 'Key-Design Architects is het bureau van Kenneth Keyaerts, erkend architect in Lier. We werken voor particulieren die hun woning willen verbouwen of bouwen, en voor ontwikkelaars die een site tot zijn volle waarde willen brengen.')}</p>
          <p>{s('introText2', 'Elk ontwerp wordt getoetst aan de werkelijkheid: de regelgeving, het budget en wat een aannemer er later mee moet doen. Eén vaste architect volgt uw project op, van het eerste idee tot de sleuteloverdracht.')}</p>
          <a href="/aanpak" class="inline-block pt-2 text-sm font-bold text-terracotta hover:text-terracotta-dark">{s('introLink', 'Ontdek onze aanpak')} →</a>
        </div>
      </div>

      {introImage && (
        <figure class="reveal mt-16 sm:mt-20 rounded-2xl overflow-hidden bg-sand-medium aspect-[4/3] sm:aspect-[16/8]">
          <Img parallax src={introImage} alt={developmentProject?.title || 'Key-Design Architects'} class="w-full h-full object-cover" width="1600" height="800" sizes="100vw" />
        </figure>
      )}

      <div class="mt-16 sm:mt-20 grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-0 md:divide-x md:divide-earth-dark/15">
        {[
          ['haalbaarheid', s('introPillar1Title', 'Onderzoek'), s('introPillar1Text', 'Eerst de plek, de regels en het budget. Pas dan het ontwerp.')],
          ['kenneth', s('introPillar2Title', 'Eén aanspreekpunt'), s('introPillar2Text', 'De architect die tekent, is ook de architect die opvolgt.')],
          ['projecten', s('introPillar3Title', 'Zorgeloze realisatie'), s('introPillar3Text', 'Techniek en budget worden even streng bewaakt als het ontwerp.')],
        ].map(([icon, title, text], i) => (
          <div class="reveal md:px-10 first:md:pl-0 last:md:pr-0" style={`transition-delay:${i * 0.1}s`}>
            <DoodleIcon name={icon as any} animate class="w-14 h-14 -ml-1.5 text-terracotta" />
            <h3 class="mt-5 text-xl font-bold text-earth-dark">{title}</h3>
            <p class="mt-2 text-sm text-earth-muted leading-relaxed max-w-xs">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- KENNETH TEASER -->
  <section class="relative overflow-hidden py-14 bg-white isolate">
    <FloatingDoodles seed={2} />
    <ArchitecturalMotifs variant="b" />
    <div class="container-page">
      <div class="card-cartoon reveal p-6 sm:p-8 flex flex-col sm:flex-row items-center gap-6 sm:gap-8">
        <Img sizes="160px"
          src={portrait}
          alt="Kenneth Keyaerts, erkend architect bij Key-Design Architects"
          class="w-28 h-28 sm:w-32 sm:h-32 rounded-full object-cover border-2 border-earth-dark shrink-0"
          width="128"
          height="128"
        />
        <div class="flex-1 text-center sm:text-left">
          <span class="text-[11px] font-bold uppercase tracking-wider text-terracotta">Uw architect</span>
          <h2 class="text-xl sm:text-2xl font-bold text-earth-dark mt-1">Kenneth Keyaerts</h2>
          <p class="mt-2 text-sm text-earth-muted leading-relaxed max-w-lg">
            Erkend architect bij de Orde van Architecten, uw vaste aanspreekpunt van de eerste schets tot de sleuteloverdracht.
          </p>
        </div>
        <a href="/over-ons" class="btn-cartoon-secondary py-3 px-6 text-xs font-bold uppercase tracking-wider shrink-0">
          Maak kennis met Kenneth →
        </a>
      </div>
    </div>
  </section>

  <!-- PORTFOLIO HIGHLIGHTS: two audiences, two angles -->
  <section class="py-14 bg-sand-light relative overflow-hidden isolate">
    <FloatingDoodles seed={3} />
    <div class="container-page">
      <div class="reveal mb-8 max-w-2xl">
        <div class="flex items-center gap-3">
          <DoodleIcon name="projecten" animate class="w-9 h-9 text-terracotta shrink-0" />
          <span class="text-xs font-bold uppercase tracking-wider text-terracotta">{s('portfolioCategory', 'Realisaties & Concepten')}</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-earth-dark mt-3">{s('portfolioTitle', 'Geselecteerde Projecten')}</h2>
        <p class="mt-3 text-earth-muted leading-relaxed">
          {s('portfolioIntro', 'Van een persoonlijke verbouwing tot een volledig vastgoedontwikkelingsproject: Key-Design begeleidt beide met dezelfde grondigheid.')}
        </p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {residentialProject && (
          <a href={`/portfolio/${residentialProject.slug}`} class="card-cartoon portfolio-grid-item reveal block overflow-hidden group">
            <div class="aspect-[16/10] overflow-hidden bg-sand-medium border-b-2 border-earth-dark relative">
              <Img src={residentialProject.image} alt={residentialProject.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" width="800" height="500" sizes="(min-width:1024px) 50vw, 100vw" />
              <span class="badge-cartoon absolute top-4 left-4 py-1.5 px-3.5 text-[10px] font-bold uppercase tracking-wider">Voor particulieren</span>
            </div>
            <div class="p-6">
              <span class="text-[10px] font-bold uppercase tracking-wider text-terracotta">{residentialProject.category}</span>
              <h3 class="font-bold text-xl text-earth-dark mt-1">{residentialProject.title}</h3>
              <p class="text-xs text-earth-muted mt-1">{residentialProject.location} · {residentialProject.year}</p>
              <p class="mt-3 text-sm text-earth-muted leading-relaxed">Uw eigen woning, van eerste idee tot een verbouwing die klopt tot in de details.</p>
              <span class="inline-block mt-4 text-sm font-bold text-terracotta group-hover:text-terracotta-dark">Bekijk deze verbouwing →</span>
            </div>
          </a>
        )}
        {developmentProject && (
          <a href={`/portfolio/${developmentProject.slug}`} class="card-cartoon portfolio-grid-item reveal block overflow-hidden group" style="transition-delay:0.08s">
            <div class="aspect-[16/10] overflow-hidden bg-sand-medium border-b-2 border-earth-dark relative">
              <Img src={developmentProject.image} alt={developmentProject.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" width="800" height="500" sizes="(min-width:1024px) 50vw, 100vw" />
              <span class="py-1.5 px-3.5 text-[10px] font-bold uppercase tracking-wider rounded-full border-2 border-earth-dark bg-earth-dark text-white absolute top-4 left-4 shadow-[3px_3px_0_0_#1C1917]">Voor ontwikkelaars & vastgoed</span>
            </div>
            <div class="p-6">
              <span class="text-[10px] font-bold uppercase tracking-wider text-terracotta">{developmentProject.category}</span>
              <h3 class="font-bold text-xl text-earth-dark mt-1">{developmentProject.title}</h3>
              <p class="text-xs text-earth-muted mt-1">{developmentProject.location}</p>
              <p class="mt-3 text-sm text-earth-muted leading-relaxed">Haalbaarheid, ruimtelijk rendement en architecturale meerwaarde voor uw vastgoedproject.</p>
              <span class="inline-block mt-4 text-sm font-bold text-terracotta group-hover:text-terracotta-dark">Ontdek dit ontwikkelingsproject →</span>
            </div>
          </a>
        )}
      </div>
      <div class="reveal text-center mt-8">
        <a href="/portfolio" class="text-sm font-bold text-terracotta hover:text-terracotta-dark">Bekijk alle projecten →</a>
      </div>
    </div>
  </section>

  <!-- THROUGH RENDERS TEASER -->
  <section class="py-12 bg-sand-medium relative overflow-hidden isolate">
    <FloatingDoodles seed={4} />
    <div class="container-page">
      <div class="card-cartoon reveal p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center gap-6">
        <Img sizes="128px" src={trLogo} alt="Through Renders" class="h-24 w-auto rounded-xl border-2 border-earth-dark shrink-0" width="64" height="96" />
        <div class="flex-1">
          <span class="text-[11px] font-bold uppercase tracking-wider text-terracotta">{s('throughRendersCategory', 'Onze Visualisatiepartner')}</span>
          <h2 class="text-xl sm:text-2xl font-bold text-earth-dark mt-1">{s('throughRendersTitle', 'Fotorealistische 3D Renders door Through Renders')}</h2>
          <p class="mt-2 text-sm text-earth-muted leading-relaxed max-w-xl">{s('throughRendersText')}</p>
        </div>
        <a href="https://www.throughrenders.be" target="_blank" rel="noopener noreferrer" class="btn-cartoon-secondary py-3 px-6 text-xs font-bold uppercase tracking-wider shrink-0">
          {s('throughRendersBtn', 'Bezoek Through Renders')} →
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-14 bg-earth-dark text-white relative overflow-hidden isolate">
    <FloatingDoodles seed={5} />
    <div class="container-page text-center reveal">
      <h2 class="text-3xl sm:text-4xl font-bold">{s('trajectoryBannerTitle', 'Klaar om jouw project vrijblijvend te bespreken?')}</h2>
      <p class="mt-4 text-stone-300 max-w-xl mx-auto">{s('trajectoryBannerSubtitle')}</p>
      <a href="/contact" class="btn-cartoon-primary inline-block mt-8 py-3.5 px-8 text-sm font-bold uppercase tracking-wider">
        {s('trajectoryCtaBtn', 'Bespreek uw project met Kenneth')}
      </a>
    </div>
  </section>
</Layout>
