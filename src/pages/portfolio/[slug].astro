---
import Img from '../../components/Img.astro';
import DoodleIcon from '../../components/DoodleIcon.astro';
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../lib/data';

export function getStaticPaths() {
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const gallery = project.images?.length ? project.images : [project.image];
---

<Layout
  title={`${project.title} | Key-Design Architects`}
  description={project.description}
  path={`/portfolio/${project.slug}`}
  altLangPath={`/en/portfolio/${project.slug}`}
  ogImage={project.image}
  breadcrumbs={[
    { name: 'Projecten', url: '/portfolio' },
    { name: project.title, url: `/portfolio/${project.slug}` },
  ]}
>
  <article class="py-10 sm:py-14">
    <div class="container-page">
      <nav class="reveal text-xs text-earth-muted mb-6">
        <a href="/portfolio" class="hover:text-terracotta">Projecten</a> / <span class="text-earth-dark">{project.title}</span>
      </nav>

      <div class="reveal grid grid-cols-1 lg:grid-cols-3 gap-10 mb-8">
        <div class="lg:col-span-2">
          <DoodleIcon name="projecten" animate class="w-12 h-12 text-terracotta mb-3" />
          <span class="text-[11px] font-bold uppercase tracking-wider text-terracotta">{project.category}</span>
          <h1 class="text-3xl sm:text-4xl font-bold text-earth-dark mt-2">{project.title}</h1>
          <p class="mt-3 text-earth-muted">{project.location} · {project.year} · {project.area}</p>
        </div>
        {project.quote && (
          <blockquote class="lg:col-span-1 border-l-4 border-terracotta pl-5 italic text-earth-muted self-center">
            “{project.quote}”
          </blockquote>
        )}
      </div>

      {project.attributionNote && (
        <div class="reveal p-5 mb-8 rounded-2xl bg-amber-50 border-2 border-amber-700/40">
          <p class="text-[11px] font-bold uppercase tracking-wider text-amber-800 mb-1.5">Herkomst van dit project</p>
          <p class="text-sm text-amber-900 leading-relaxed">{project.attributionNote}</p>
        </div>
      )}

      {project.statusNote && (
        <div class="reveal p-5 mb-8 rounded-2xl bg-sky-50 border-2 border-sky-700/40">
          <p class="text-[11px] font-bold uppercase tracking-wider text-sky-800 mb-1.5">Status van dit project</p>
          <p class="text-sm text-sky-900 leading-relaxed">{project.statusNote}</p>
        </div>
      )}

      <figure class="reveal rounded-3xl overflow-hidden border border-sand-dark/40 mb-8 bg-sand-medium">
        <Img eager priority src={project.image} alt={project.title} class="w-full h-auto object-cover" width="1400" height="900" sizes="100vw" />
      </figure>

      <div class="reveal grid grid-cols-1 lg:grid-cols-3 gap-10 mb-16">
        <div class="lg:col-span-2 space-y-6">
          <h2 class="font-serif text-2xl font-bold text-earth-dark">Concept</h2>
          <p class="text-earth-muted leading-relaxed">{project.description}</p>
          {project.concept && <p class="text-earth-muted leading-relaxed">{project.concept}</p>}
        </div>
        <div class="space-y-6">
          {project.materials?.length ? (
            <div>
              <h3 class="text-xs font-bold uppercase tracking-wider text-terracotta mb-2">Materialen</h3>
              <ul class="space-y-1.5 text-sm text-earth-muted">
                {project.materials.map((m: string) => <li>• {m}</li>)}
              </ul>
            </div>
          ) : null}
          {project.specs && Object.keys(project.specs).length ? (
            <div>
              <h3 class="text-xs font-bold uppercase tracking-wider text-terracotta mb-2">Specificaties</h3>
              <dl class="space-y-1.5 text-sm">
                {Object.entries(project.specs).map(([k, v]) => (
                  <div class="flex justify-between gap-4">
                    <dt class="text-earth-muted">{k}</dt>
                    <dd class="text-earth-dark font-medium text-right">{v as string}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ) : null}
        </div>
      </div>

      {gallery.length > 1 && (
        <div class="reveal mb-16">
          <h2 class="font-serif text-2xl font-bold text-earth-dark mb-6">Beeldmateriaal</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {gallery.map((img: string, i: number) => (
              <Img src={img} alt={`${project.title}, beeld ${i + 1}`} class="rounded-2xl w-full h-auto object-cover" width="700" height="500" sizes="(min-width:768px) 50vw, 100vw" />
            ))}
          </div>
        </div>
      )}

      {project.timeline?.length ? (
        <div class="reveal mb-16">
          <h2 class="font-serif text-2xl font-bold text-earth-dark mb-6">Traject</h2>
          <div class="space-y-6">
            {project.timeline.map((step: any) => (
              <div class="p-6 rounded-2xl bg-sand-light border border-sand-dark/40">
                <span class="text-[11px] font-bold uppercase tracking-wider text-terracotta">{step.phase} · {step.date}</span>
                <h3 class="font-serif font-bold text-lg text-earth-dark mt-1">{step.title}</h3>
                <p class="text-sm text-earth-muted mt-2">{step.description}</p>
              </div>
            ))}
          </div>
        </div>
      ) : null}

      <div class="reveal text-center bg-earth-dark text-white rounded-3xl p-10 sm:p-14">
        <h2 class="text-2xl sm:text-3xl font-bold">Een gelijkaardig project in gedachten?</h2>
        <a href="/contact" class="btn-cartoon-primary inline-block mt-6 py-3.5 px-8 text-sm font-bold uppercase tracking-wider">
          Bespreek uw project met Kenneth
        </a>
      </div>
    </div>
  </article>
</Layout>
