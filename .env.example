# EmailJS (free tier is enough): create an account at https://www.emailjs.com,
# add an Email Service + a template, then fill these in. Without them the
# contact form still saves each lead to Firestore (visible in /beheerder),
# it just won't also email Kenneth directly.
PUBLIC_EMAILJS_PUBLIC_KEY=""
PUBLIC_EMAILJS_SERVICE_ID=""
PUBLIC_EMAILJS_TEMPLATE_ID=""

# Netlify build hook URL (Site settings -> Build & deploy -> Build hooks ->
# Add build hook). Lets the "Publiceren" button in /beheerder trigger a
# rebuild so saved edits go live automatically.
PUBLIC_BUILD_HOOK=""
